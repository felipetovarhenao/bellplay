pack = (
    $buffers,
    $resamplingfiltersize = 11,
    $resamplingmode = 'sinc',
    $resamplingpolicy = 3 -> (
        $self = 'pack';
        BP_FN_CHECK_ARGS($self, 'buffers', $buffers);
        $buffers = for $b in $buffers collect BP_FN_DETACH_BUFFER($b @origin $self).getkey("source");
        BP_FN_DISPATCH('ears', 
            ['pack' 
                [ 'resamplingfiltersize' $resamplingfiltersize ]
                [ 'resamplingmode' $resamplingmode ]
                [ 'resamplingpolicy' $resamplingpolicy ]
                [ 'buffers' $buffers ]
            ]
        );
        $source = BP_TMP_EARS_OUTPUT;
        BP_FN_DETACH_BUFFER(BP_FN_NEWBUFF($source) @strict 1 @origin $self)
        
    )
);

BP_REF_NEW(
    @name "pack"
    @description "Combines multiple buffers as channels into a single buffer."
    @category BP_REF_LABEL_BUFFER_UTILS
    @arguments (
        BP_REF_ARG(@name "buffers" @type "llll" @description "Audio samples to convert to a buffer.")
        BP_REF_ARG(@name "resamplingfiltersize" @default 11 @type "int" @description "Resampling filter size.")
        BP_REF_ARG(@name "resamplingmode" @default "'sinc'" @type "symbol" @description "Resampling mode." @options
            BP_REF_RESAMPLINGMODE_OPTIONS
        )
        BP_REF_ARG(@name "resamplingpolicy" @default 3 @type "int" @description "Resampling policy." @options
            BP_REF_RESAMPLINGPOLICY_OPTIONS
        )
    )
    @output BP_REF_OUTPUT(@description "New buffer" @type "llll")
    @usage BP_REF_CODE_SNIPPET("$dur = 1000;
$chan1 = cycle(440, $dur).process(
    gain([0 0.1 0] [1 0 0.125])
);
$chan2 = noise($dur).process(
    gain([0 0 0] [1 0.1 0.125])
);
$chan1.view('first channel');
$chan2.view('second channel');
$packed = pack($chan1 $chan2);
$packed.view('packed channels')"
    )
);

