## ------------------------------------------------------------

biquad = (
    $frequency = 2000,
    $type = 2,
    $gain = 1,
    $q = 100 -> (
        $self = 'biquad';
        $frequency = BP_FN_CLEAN_AUDIO_PARAM($self, $frequency);
        $gain = BP_FN_CLEAN_AUDIO_PARAM($self, $gain);
        $q = BP_FN_CLEAN_AUDIO_PARAM($self, $q);
        if contains($type) == 16 then (
            $type = (
                [ "lowpass" 0 ]
                [ "highpass" 1 ]
                [ "bandpass" 2 ]
                [ "bandstop" 3 ]
                [ "peaknotch" 4 ]
                [ "lowshelf" 5 ]
                [ "highshelf" 6 ]
                [ "resonant" 7 ]
                [ "allpass" 8 ]
            ).$type
        );
        $type ||| BP_FN_ERROR('biquad', "invalid value for @type");
        [
            [ "fx" "biquad" ]
            [ "params" 
                [ "type" "edit_mode" $type + 1 ]
                [ "frequency" $frequency ]
                [ "gain" $gain ]
                [ "q" $q ]
            ]
        ]
    )
);

BP_REF_NEW(
    @name "biquad"
    @description "Generates an audio process operation for applying biquad filtering to a buffer."
    @category BP_REF_LABEL_BUFFER_OPERATIONS
    @arguments (
        BP_REF_ARG(@name "frequency" @default 2000 @type "int/float" @description "Cutoff/center frequency, either as a single number, or envelope.")
        BP_REF_ARG(@name "type" @type "int/symbol" @default 2 @description "Filter type, as a symbol or integer." @options
            BP_REF_OPT(@value 0 @description "Lowpass")
            BP_REF_OPT(@value 1 @description "Highpass")
            BP_REF_OPT(@value 2 @description "Bandpass")
            BP_REF_OPT(@value 3 @description "Bandstop")
            BP_REF_OPT(@value 4 @description "Peaknotch")
            BP_REF_OPT(@value 5 @description "Lowshelf")
            BP_REF_OPT(@value 6 @description "Highshelf")
            BP_REF_OPT(@value 7 @description "Resonant")
            BP_REF_OPT(@value 8 @description "Allpass")
        )
        BP_REF_ARG(@name "gain" @default 1 @type "int/float" @description "Linear gain, either as a single number, or envelope.")
        BP_REF_ARG(@name "q" @default 80 @type "int/float" @description "Resonance or slope, depending on `@type`, either as a single number, or envelope.")
    )
    @output BP_REF_OUTPUT(@description "Biquad operation" @type "llll")
    @tags 'onepole'
);

