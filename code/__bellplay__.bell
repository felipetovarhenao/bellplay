            @name "temporalcentroid"
        )
    )
);

BP_REF_NEW(
    @name "temporalcentroid"
    @description "Generates an audio descriptor to calculate the temporal centroid of a buffer, defined as the point in time that is a temporal balancing point of the sound's energy."
    @category BP_REF_LABEL_BUFFER_ANALYSIS
    @output BP_REF_OUTPUT(@description "Temporalcentroid descriptor" @type "llll")
);

