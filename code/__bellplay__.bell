buf2samps = (
    $buffer -> (
        $self = 'buf2samps';
        $source = BP_FN_DETACH_BUFFER($buffer @origin $self).getkey('source');
        BP_FN_DISPATCH('ears', ['tosamps' $source]);
        BP_TMP_EARS_OUTPUT
    )
);

BP_REF_NEW(
    @name "buf2samps"
    @description "Buffer to samples conversion."
    @category BP_REF_LABEL_BUFFER_UTILS
    @arguments (
        BP_REF_ARG(@name "buffer", @type "llll", @description "Buffer to convert to audio samples.")
    )
    @output BP_REF_OUTPUT(@description "Buffer samples as a _llll_" @type "llll")
    @usage BP_REF_CODE_SNIPPET("$buf = envelope([0 0 0] [1 1 0.125] @duration 5);
$samps = $buf.buf2samps();
$buf.view('buffer');
$samps.view('samps')")
);

## ------------------------------------------------------------

samps2buf = (
    $llll,
    $sr = 0 -> (
        $self = 'samps2buf';
        BP_FN_CHECK_ARGS($self, 'llll', $llll);
        if depth($llll) != 2 then (
            BP_FN_ERROR($self, '@llll must have a depth of 2')
        ) else (
            BP_FN_DISPATCH('ears', 
                ['fromsamps' 
                    ['sr' $sr]
                    ['source' $llll]
                ]
            );
            $source = BP_TMP_EARS_OUTPUT;
            BP_FN_DETACH_BUFFER(BP_FN_NEWBUFF($source) @strict 1 @origin $self)
        )
    )
);

BP_REF_NEW(
    @name "samps2buf"
    @description "Samples to buffer conversion."
    @category BP_REF_LABEL_BUFFER_UTILS
    @arguments (
        BP_REF_ARG(@name "llll" @type "llll" @description "Audio samples to convert to a buffer.")
        BP_REF_ARG(@name "sr" @type "int" @default 0 @description "Sampling rate. use `0` for default sampling rate.")
    )
    @output BP_REF_OUTPUT(@description "Buffer" @type "llll")
    @usage BP_REF_CODE_SNIPPET("$samps = [0 1 0 -1 0]; ## brackets specify samples per channel
samps2buf($samps).view()"
    )
);

