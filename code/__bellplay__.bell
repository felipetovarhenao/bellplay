hoaencode = (
    $azimuth = 0,
    $elevation = 0,
    $distance = 1,
    $order = 1,
    $coordtype = 'aed',
    $dimension = '3D',
    $angleunit = 0,
    $envtimeunit = 2 -> (
        $self = 'hoaencode';
        [
            [ "fx" "hoaencode" ]
            [ "params"
                [ 'azimuth' BP_FN_CLEAN_AUDIO_PARAM($self, $azimuth) ]
                [ 'elevation' BP_FN_CLEAN_AUDIO_PARAM($self, $elevation) ]
                [ 'distance' BP_FN_CLEAN_AUDIO_PARAM($self, $distance) ]
                [ 'order' $order ]
                [ 'angleunit' $angleunit ]
                [ 'envtimeunit' $envtimeunit ]
                [ 'coordtype' $coordtype ]
                [ 'dimension' $dimension ]
            ]
        ]
    )
);

BP_REF_NEW(
    @name "hoaencode",
    @description "Generates an audio process operation for panning the input buffer and encode it as a higher-order [ambisonic](https://en.wikipedia.org/wiki/Ambisonics) buffer."
    @category BP_REF_LABEL_BUFFER_OPERATIONS
    @arguments (
        BP_REF_ARG(@name "azimuth" @default 0 @type "int/float/llll" @description "Azimuth or X coordinate, either as a single number, or envelope.")
        BP_REF_ARG(@name "elevation" @default 0 @type "int/float/llll" @description "Elevation or y coordinate, either as a single number, or envelope.")
        BP_REF_ARG(@name "distance" @default 1 @type "int/float/llll" @description "Distance or Z coordinate, either as a single number, or envelope.")
        BP_REF_ARG(@name "order" @default 1 @type "int" @description "Ambisonics order.")
        BP_REF_ARG(@name "coordtype" @default "'aed'" @type "symbol" @description "Input coordinate type" @options
            BP_REF_OPT(@value "'aed'" @description "Azimuth, elevation, and distance; or spherical coordinates.")
            BP_REF_OPT(@value "'xyz'" @description "Cartesian coordinates.")
            BP_REF_OPT(@value "'azr'" @description "Azimuth, Z, axial radius; or cylindrical coordinates.")
        )
        BP_REF_ARG(@name "dimension" @default "'3D'" @type "symbol" @description "Dimensionality of ambisonics" @options 
            BP_REF_OPT(@value "'2D'" @description "2-dimensional.")
            BP_REF_OPT(@value "'3D'" @description "3-dimensional.")
        )
        BP_REF_ARG(@name "angleunit" @default 0 @type "int" @description "Unit for angles" @options 
            BP_REF_ANGLEUNIT_OPTIONS
        )
        BP_REF_ARG(@name "envtimeunit" @default 0 @type "int" @description "Unit for time values inside envelopes/bpfs." @options
            BP_REF_TIMEUNIT_OPTIONS
        )
    )
    @output BP_REF_OUTPUT(@description "Higher-order ambisonics encoding operation" @type "llll")
);

