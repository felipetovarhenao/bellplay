BP_REF_NEW(
    @name "spectralflatness"
    @description "Generates an audio descriptor to calculate the spectral flatness of a buffer, defined as the ratio between the spectrum's geometric mean and arithmetic mean."
    @category BP_REF_LABEL_BUFFER_ANALYSIS
    @arguments (
        BP_REF_ARG(@name "mode" @default 0 @type "int", @description "Analysis mode." @options
            BP_REF_ESSENTIA_ANALYSIS_OPTIONS
        )
    )
    @output BP_REF_OUTPUT(@description "Spectralflatness descriptor" @type "llll")
);

## ------------------------------------------------------------

temporalflatness = ( 
    -> ( 
        BP_FN_ESSENTIA(
            @name "temporalflatness"
        )
    )
);

BP_REF_NEW(
    @name "temporalflatness"
    @description "Generates an audio descriptor to calculate the temporal flatness of a buffer, defined as the ratio between the buffer envelope's geometric mean and arithmetic mean. Flatness is undefined for empty input and negative values, therefore an exception is thrown in any both cases."
    @category BP_REF_LABEL_BUFFER_ANALYSIS
    @output BP_REF_OUTPUT(@description "Temporalflatness descriptor" @type "llll")
    @usage BP_REF_ANALYZE_EXAMPLE('temporalflatness' @buffer 'envelope([0 0 0] [1 1 0.25])')
);

