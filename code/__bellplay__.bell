onepole = (
    $cutoff = 300,
    $highpass = 0 -> (
        BP_FN_CHECK_ARGS('onepole', 'cutoff', $cutoff);
        [
            [ "fx" "onepole" ]
            [ "params"
                [ "cutoff" $cutoff ]
                [ "highpass" $highpass ]
            ]
        ]
    )
);

BP_REF_NEW(
    @name "onepole"
    @description "Generates an audio process operation for applying single-pole lowpass or highpass filtering to a buffer."
    @category BP_REF_LABEL_BUFFER_OPERATIONS
    @arguments (
        BP_REF_ARG(@name "cutoff" @default 300 @type "int/float" @description "Cutoff frequency.")
        BP_REF_ARG(@name "highpass" @default 0 @type "int" @description "Highpass filter mode." @options
            BP_REF_SWITCH_OPTIONS
        )
    )
    @output BP_REF_OUTPUT(@description "Single-pole filtering operation" @type "llll")
);

