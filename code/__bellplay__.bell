    @description "Generates an audio process operation for applying [Ztx-based](https://www.zynaptiq.com/ztx/) pitch shifting to a buffer."
    @category BP_REF_LABEL_BUFFER_OPERATIONS
    @arguments (
        BP_REF_ARG(@name "shift" @default 1 @type "int/float/list/llll" @description "Pitch shift as a factor of the original pitch (i.e. 2.0 = doubling of pitch, .5 = halving of the original pitch, etc.), or in cents if `@usecents` is set to `1`. Either as a single value, envelope, or buffer.")
        BP_REF_ARG(@name "constantlatency" @default 0 @type "int" @description "Constant latency." @options
            BP_REF_SWITCH_OPTIONS
        )
        BP_REF_ARG(@name "quality" @default "'basic'" @type "symbol" @description "Pitch shifting output quality." @options
            BP_REF_OPT(@value "'basic'")
            BP_REF_OPT(@value "'good'")
            BP_REF_OPT(@value "'better'")
            BP_REF_OPT(@value "'best'")
        )
