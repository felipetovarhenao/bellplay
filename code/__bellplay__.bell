## ------------------------------------------------------------

addmarker = (
    $onset,
    $names = null,
    $role = null -> (
        $self = 'addmarker';
        BP_FN_CHECK_ARGS($self, 'onset', $onset);
        if $role:1 == 'timesig' then (
            ($role:2 &&& $role:3) ||| BP_FN_ERROR($self, "'timesig' role must be followed by a time signature: <num> <den>");
            $role = $role:1 [ right($role, 1) ]
        ) else if $role:1 == 'tempo' then (
            ($role:2 &&& $role:3) ||| BP_FN_ERROR($self, "'tempo' role must be followed by a tempo assignment: <beat_unit> <bpm>");
            $role = $role:1 [ right($role, 1) ]
        ) else if $role &&& $role.intersection('barline' 'division' 'subdivision') == null then (
            BP_FN_ERROR($self, "invalid marker role")
        );
        BP_FN_DISPATCH("roll", "addmarker" $onset [ $names ] $role)
    )
);

BP_REF_NEW(
    @name "addmarker"
    @description "Inserts a marker into the transcription score, given an onset time and, optionally, a list of names and/or role associated with that marker. Note that if marker role is assigned, names are not displayed in the score but are still associated with the marker. Roles are particularly useful when exporting scores as `llll` files for quantization purposes."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "onset" @type "int/float" @description "Marker onset position.")
        BP_REF_ARG(@name "names" @default "null" @type "symbol/list/null" @description "Optional list of marker names.")
        BP_REF_ARG(@name "role" @default "null" @type "symbol/list/null" @description "Optional marker role." @options
            BP_REF_OPT(@value "'tempo <unit> <bpm>'" @description "Tempo marker role, followed by a tempo specification, as a unit ratio and bpm value.")
            BP_REF_OPT(@value "'timesig <time_sig_num> <time_sig_den>'" @description "Time signature marker role, followed by a time signature, as a pair of numerator and denominator.")
            BP_REF_OPT(@value "'barline'" @description "Barline marker role.")
            BP_REF_OPT(@value "'division'" @description "Beat division marker role.")
            BP_REF_OPT(@value "'subdivision'" @description "Beat subdivision marker role.")
        )
    )
    @usage BP_REF_CODE_SNIPPET("$onsets = 0 500 1000 1500 2000;
for $onset $i in $onsets do (
    addmarker(@onset $onset @names $i)
)")
);

## ------------------------------------------------------------

pcdiff = (
    $a, $b, $mod = 12 -> ( 
        BP_FN_CHECK_ARGS('pcdiff', 'a', $a, 'b', $b);
        $a = fmod($a, $mod); 
        $b = fmod($b, $mod); 
        $da = $b - $a;
        $db = $da + $mod * -sgn($da); 
        $mask = max(0, sgn(abs($db) - abs($da)));
        $da * $mask + $db * (1 - $mask)
    ) 
);

BP_REF_NEW(
    @name "pcdiff"
    @description "Signed pitch class difference."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "a" @type "int/float/list" @description "Pitch classes.")
        BP_REF_ARG(@name "b" @type "int/float/list" @description "Pitch classes.")
        BP_REF_ARG(@name "mod" @default 12 @type "int/float/list" @description "Modulo.")
    )
    @output BP_REF_OUTPUT(@description "Signed difference" @type "int/float/list")
);

## ------------------------------------------------------------

createdbtable = (
    $data = null, $name = 'data', $db = null -> (
        $self = 'createdbtable';
        BP_FN_CHECK_ARGS(
            $self, 'data', $data, 'name', $name
        );
        $db = $db ||| 'main';
        if intersection($name, 'table') != null then BP_FN_ERROR($self, 'forbidden table name:' $name);
        $table = for $keyval in $data::1 with @unwrap 1 collect (
            $key = $keyval.left(1);
            if is($key) != 'symbol' then (BP_FN_ERROR($self, 'invalid data. Every element must be structured as a list of key-value pairs:' $keyval) );
            $val = $keyval.right(1);
            $type = null;
            $contains = $val.contains();
            $type = if $val == null || is($val) == 'list' then (
                ## ----
                'l' 
            ) else if $contains == 2 then (
                ## ----
                'i' 
            ) else if $contains == 4 then (
                ## ----
                'r' 
            ) else if $contains == 8 then (
                ## ----
                'f' 
            ) else if $contains == 16 then (
                ## ----
                's' 
            ) else if $contains == 256 then (
                ## ----
                'p' 
            ) else (
                ## ----
                'l' 
            );
            [$key $type] 
        );
        BP_FN_DISPATCH('db', ['name' $db]);
        if BP_DATABASE_TABLES.$db == null then (
            BP_DATABASE_TABLES _= [$db];
            BP_FN_DISPATCH('db', ['erase']);
            BP_FN_SANDBOX_NEWOBJ('dada.base', $db);
            BP_FN_SANDBOX_GEN()
        ) else if intersection(BP_DATABASE_TABLES.$db, $name) != null then (
            BP_FN_ERROR($self, 'table already exists in database named' $db + ':' $name)
        );
        BP_FN_DISPATCH(
            'db',  [ 'addtable' $name $table ] 
        );
        BP_DATABASE_TABLES.$db _= $name;
        for $entry in $data with @unwrap 1 do (
            $entry = $entry.map(
                ## nullify inf and nan values
                $x -> (
                    if $x.contains() <= 8 && ($x.abs() == BP_INF || $x.isnan()) then null else $x
                ) @maxdepth -1
            );
            BP_FN_DISPATCH('db', [ 'addentry' $name $entry]) 
        );
        null
    ) 
);

BP_REF_NEW(
    @name "createdbtable"
    @description BP_REF_MULTILINE("Creates and populates a [SQLite3](https://www.sqlitetutorial.net/) table with data entries.",
    'Each element or entry in `@data` should be structured as a _llll_ of key-value pairs, where each key corresponds to a column name in the resulting table and each value is the corresponding data entry. 
For example:

```bell title="expected structure for each data entry"
[ ## item 1
    [ <key_1> <value_1> ]
    [ <key_2> <value_2> ]
    ...
    [ <key_N> <value_N> ]
]
...
[ ## item N
    [ <key_1> <value_1> ]
    [ <key_2> <value_2> ]
    ...
    [ <key_N> <value_N> ]
]
```

This format ensures that the resulting table can be queried using standard SQL-style syntax, with each key becoming a column in the table schema.'
    )
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "data" @type "llll" @description "Data from which to build SQL table, each element structured as a list of key-value pairs.")
        BP_REF_ARG(@name "name" @default "'data'" @type "symbol" @description "SQL Table name, to be used with `querydb`. For instance, for a table named `'mytable'`, a basic query would be `'SELECT * FROM mytable'`.")
        BP_REF_ARG(@name "db" @default "null" @type "symbol/null" @description "Optional database name. If set to `null`, `'main'` is used as the default database name.")
    )
    @usage BP_REF_DATABASE_SNIPPET
    @tags 'querydb' 'readdb' 'writedb'
);

## ------------------------------------------------------------

querydb = (
    $sql = null, $db = null -> (
        BP_DATABASE_OUTPUT = null;
        $db = $db ||| 'main';
        $self = 'querydb';
        BP_FN_CHECK_ARGS($self, 'sql', $sql, $db, 'db');
        if is($sql) != 'symbol' then BP_FN_ERROR($self, '@sql must be a symbol:' $sql);
        if is($db) != 'symbol' then BP_FN_ERROR($self, '@db must be a symbol:' $db);
        if BP_DATABASE_TABLES.$db == null then BP_FN_ERROR($self, "no tables found in database" $db);
        BP_FN_DISPATCH('db', ['name' $db] ['query' $sql]);
        if BP_DATABASE_OUTPUT == null then BP_FN_WARNING(
            $self, 'SQL query did not yield any results:' tosymbol($sql) 
        );
        BP_DATABASE_OUTPUT
    ) 
);

BP_REF_NEW(
    @name "querydb"
    @description "Performs a [SQLite3](https://www.sqlitetutorial.net/) query on previously created tables. See `createdbtable`."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "sql" @type "symbol" @description "SQL table query.")
        BP_REF_ARG(@name "db" @default "null" @type "symbol/null" @description "Optional database name. If set to `null`, `'main'` is used as the default database name.")
    )
    @output BP_REF_OUTPUT(@description "Query results." @type "llll/null")
    @usage BP_REF_DATABASE_SNIPPET
    @tags 'createdbtable' 'readdb' 'writedb'
);

## ------------------------------------------------------------

writedb = (
    $path = null, $db = null -> (
        $self = 'writedb';
        BP_FN_CHECK_ARGS(
            $self, 'path', $path
        );
        $db = $db ||| 'main';
        if is($path) != 'symbol' then BP_FN_ERROR($self, 'invalid @path type:' $path);
        if is($db) != 'symbol' then BP_FN_ERROR($self, 'invalid @db type:' $db);
        $info = BP_FN_PATHINFO($path);
        $ext = $info.'extension';
        if $ext != '.llll' then BP_FN_ERROR($self, 'invalid @path extension:' $ext ||| 'null');
        $path = $info.'path' + $ext;
        if BP_DATABASE_TABLES.$db == null then BP_FN_ERROR($self, "no tables found in database" $db);
        BP_FN_DISPATCH('db', ['name' $db] ['write' $path]);
        null
    ) 
);

BP_REF_NEW(
    @name "writedb"
    @description "Write [SQLite3](https://www.sqlitetutorial.net/) database `@db` as a `.llll` file."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "path" @type "symbol" @description "Destination path for SQL database as a `.llll` file.")
        BP_REF_ARG(@name "db" @default "null" @type "symbol/null" @description "Optional database name. If set to `null`, `'main'` is used as the default database name.")
    )
    @output BP_REF_OUTPUT(@description "Query results." @type "llll/null")
    @usage BP_REF_DATABASE_IO_SNIPPET
    @tags 'querydb' 'createdbtable' 'readdb'
);

## ------------------------------------------------------------

readdb = (
    $path, $db = null -> (
        $self = 'readdb';
        $info = BP_FN_PATHINFO($path);
        $ext = $info.'extension';
        if $ext != '.llll' then BP_FN_ERROR($self, 'invalid @path extension:' $ext ||| 'null');
        $path = $info.'path' + $ext;
        $db = $db ||| 'main';
        if BP_DATABASE_TABLES.$db != null then BP_FN_ERROR($self, "database already in use. Use a different @db name:" $db);
        BP_DATABASE_OUTPUT = null;
        BP_FN_DISPATCH('db', ['name' $db] ['erase']);
        BP_FN_SANDBOX_NEWOBJ('dada.base', $db);
        BP_FN_SANDBOX_GEN();
        BP_FN_DISPATCH('db', ['read' $path] ['dump']);
        $names = for $x in BP_DATABASE_OUTPUT with @unwrap 1 collect $x:(1 1);
        BP_DATABASE_TABLES _= [$db $names];
        $names
    ) 
);

BP_REF_NEW(
    @name "readdb"
    @description "Loads [SQLite3](https://www.sqlitetutorial.net/) database from `.llll` file."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "path" @type "symbol" @description "Destination path for SQL database with `.llll` extension..")
        BP_REF_ARG(@name "db" @default "null" @type "symbol/null" @description "Optional database name. If set to `null`, `'main'` is used as the default database name.")
    )
    @output BP_REF_OUTPUT(@description "Query results." @type "llll/null")
    @usage BP_REF_DATABASE_IO_SNIPPET
    @tags 'querydb' 'createdbtable' 'writedb'
);

## ------------------------------------------------------------

browsedbtable = (
    $name = 'data',
    $db = null,
    $xfield = null,
    $yfield = null,
    $sizefield = null,
    $colorfield = null,
    $shapefield = null -> (
        $self = 'browsedbtable';
        $db = $db ||| 'main';
        BP_FN_CHECK_ARGS($self, 'name', $name);
        if BP_DATABASE_TABLES.$db == null then BP_FN_ERROR($self, "no tables found in database" $db) else (
            BP_DATABASE_OUTPUT = null;
            BP_FN_DISPATCH('db', ['getcols']);
            $cols = (BP_DATABASE_OUTPUT::1).right(1).trans()::1;
            BP_DATABASE_BROWSER _= [
                [ "database" $db ]
                [ "table" $name ]
                [ "fields" 
                    [ 'xfield' intersection($cols, $xfield) ]
                    [ 'yfield' intersection($cols, $yfield) ]
                    [ 'sizefield' intersection($cols, $sizefield) ]
                    [ 'colorfield' intersection($cols, $colorfield) ]
                    [ 'shapefield' intersection($cols, $shapefield) ]
                ]
            ]
        );
        null
    )
);

BP_REF_NEW(
    @name "browsedbtable"
    @description "Displays [SQLite3](https://www.sqlitetutorial.net/) database table in the **Table Browser** window, which automatically opens after script evaluation is complete. Convenient for exploring database tables, especially those consisting of buffers."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "name" @default "'data'" @type "symbol"  @description "Name of database table to browse, as a symbol.")
        BP_REF_ARG(@name "db" @default "null" @type "symbol/null" @description "Optional database name. If set to `null`, `'main'` is used as the default database name.")
        BP_REF_ARG(@name "xfield" @default "null" @type "symbol/null" @description "Name of table column to use for _X axis_ in **Table Browser**.")
        BP_REF_ARG(@name "yfield" @default "null" @type "symbol/null" @description "Name of table column to use for _Y axis_ in **Table Browser**.")
        BP_REF_ARG(@name "size" @default "null" @type "symbol/null" @description "Name of table column to use for _Size_ in **Table Browser**.")
        BP_REF_ARG(@name "color" @default "null" @type "symbol/null" @description "Name of table column to use for _Color_ in **Table Browser**.")
        BP_REF_ARG(@name "shape" @default "null" @type "symbol/null" @description "Name of table column to use for _Shape_ in **Table Browser**.")
    )
    @usage BP_REF_CODE_SNIPPET("## import file
$buf = importaudio('trumpet.wav');
## generate audio descriptors
$descriptors = pitchmelodia() larm() spectralcentroid() effectiveduration();
## segment buffer and analyze every segment
$segments = for $b in splitbuf(@buffer $buf @split 50) collect $b.analyze($descriptors);
## create database table
createdbtable(@data $segments);
## display table in browser 
browsedbtable(
    @xfield 'pitchmelodia' 
    @yfield 'larm' 
    @sizefield 'spectralcentroid' 
    @colorfield 'effectiveduration' 
)"
    )
);

