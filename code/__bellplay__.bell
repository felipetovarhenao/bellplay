            BP_REF_TIMEUNIT_OPTIONS
        )
    )
    @output BP_REF_OUTPUT(@description "Rotate operation" @type "llll")
    @usage BP_REF_PROCESS_EXAMPLE('rotate', '@shift 2000')
);

