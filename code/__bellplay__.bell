BP_VERSION = "v0.2.8-beta";
BP_SUPPORTED_AUDIO_FORMATS = ".wav" ".aif" ".aiff" ".mp3";
BP_DATABASE_OUTPUT = null;
BP_DATABASE_TABLES = null;
BP_TREE_NORM = null;
BP_REF_LABEL_DATA_UTILS = "data utilities";
BP_REF_LABEL_RANDOMNESS = "randomness";
BP_REF_LABEL_BUFFER_OPERATIONS = "buffer operations";
BP_REF_LABEL_BUFFER_GENERATION = "buffer generation";
BP_REF_LABEL_BUFFER_ANALYSIS = "buffer analysis";
BP_REF_LABEL_BUFFER_UTILS = "buffer utilities";
BP_REF_LABEL_MATH = "math";
BP_REF = (for $i in (
    BP_REF_LABEL_DATA_UTILS 
    BP_REF_LABEL_BUFFER_OPERATIONS 
    BP_REF_LABEL_BUFFER_GENERATION 
    BP_REF_LABEL_BUFFER_ANALYSIS
    BP_REF_LABEL_RANDOMNESS
    BP_REF_LABEL_BUFFER_UTILS
    BP_REF_LABEL_MATH
) collect [ $i ]);
BP_REF_TIMEUNIT_OPTIONS = null;
BP_REF_AUDIO_DOMAIN_OPTIONS = null;
BP_TMP_BUFF = null;
BP_TMP_BUFFINFO = null;
BP_TMP_ROLL_OUTPUT = null;
BP_INF = 1./0;
BP_RAND_RES = 2147483648;
BP_URN = null;
BP_SCRIPT_PATH = null;
BP_DEFAULT_EZSAMPLER_KEYMAP = [6000 'guitar.wav' ];
BP_BUFFER_CACHE = null;
BP_PLAY_TOGGLE = 0;
BP_SCORE_CONFIG = null;
BP_CONFIG = null;
BP_MAXOBJ_RANDOM = {max.random 2147483648 @seed 1};
BP_MAXOBJ_ATOI = {max.atoi};
BP_MAXOBJ_ITOA = {max.itoa};
BP_MAXOBJ_BACHINTEGRATE = {bach.integrate};
BP_MAXOBJ_BACHDERIVE = {bach.derive};
BP_FN_CONFIG = (
    $action, $value -> (
        $bpconfigpath = '~/bellplay.config.txt';
        $exists = exists($bpconfigpath);
        $update = $conf -^ $bpconfigpath -> (
            BP_CONFIG = $conf;
            write(@data $conf @path $bpconfigpath) 
        );
        if $action == 'init' then (
            $defaultconfig = (
                ## bellplay~ version
                [ 'version' BP_VERSION] 
                ## files to automatically run at launch
                [ 'imports' ] 
                ## default text editor
                [ 'defaulteditor' ] 
                ## default tutorials directory
                [
                    'tutorialsdir' '~/Documents' 
                ] 
                ## mute sound alert when getting errors
                [ 'mutealert' 0] 
                ## open console automatically after runtime
                [ 'openwin' 1] 
            );
            if $exists == 0 then ($bpconfig = $defaultconfig) else (
                $bpconfig = read(@path $bpconfigpath);
                $defaultkeys = trans($defaultconfig)::1;
                $bpconfigkeys = trans($bpconfig)::1;
                for $key in $defaultkeys do (
                    $val = $bpconfig.$key;
                    if $val == null && intersection($bpconfigkeys, $key) == null then (
                        $bpconfig _= [$key $defaultconfig.$key]
                    ) 
                );
                $bpconfig.'version' = BP_VERSION
            );
            $update($bpconfig) 
        ) else if $exists == 1 then (
            $bpconfig = read($bpconfigpath);
            if $action == 'map' then (
                $bpconfig = $value($bpconfig);
                if $bpconfig != null then $update($bpconfig) 
            ) else if $action == 'read' then (
                $imports = $bpconfig.'imports';
                if $imports != null then (
                    $scripts = null;
                    $imports = for $import in $imports collect (
                        $importpath = parsepath($import);
                        $ext = getkey($importpath, 'extension');
                        if $ext == '.bell' && exists($import) == 1 then (
                            BP_FN_DISPATCH('loadscript', $import);
                            $scripts _= getkey($importpath, 'name') + $ext;
                            $import
                        ) else BP_FN_WARNING(@details 'invalid import file:' $import ||| 'null') 
                    );
                    $bpconfig.'imports' = $imports;
                    BP_FN_PRINT(BP_REF_MULTILINE('Imported default scripts:', for $script in $scripts collect '• ' + $script));
                    $update($bpconfig) 
                ) 
            ) else if $action == 'get' then ($bpconfig.$value) 
        ) else BP_FN_WARNING(@details 'configuration file not found.') 
    ) 
);
BP_FN_ON_LAUNCH = (
    -> (
        ## load imports
        BP_FN_CONFIG('init')
    ) 
);
BP_FN_ON_BEFORE = (
    -> (
        BP_FN_SANDBOX_CLEAR();
        setseed(1); 
        scoreconfig();
        BP_URN = null; 
        BP_VIEWER_DATA = null;
        BP_DATABASE_BROWSER = null;
        BP_DATABASE_TABLES = null;
        BP_FN_DISPATCH('db', ['erase']);
        BP_BUFFER_CACHE = null;
        BP_PLAY_TOGGLE = 0
    )
);
BP_FN_ON_AFTER = (
    -> (
        if BP_SCORE_CONFIG."showdynamics" == 1 then (
            BP_FN_DISPATCH("roll", 
                 "velocities2dynamics" "@unnecessary" 1 "@thresh" 1. "@maxchars" 3
            );
            BP_FN_DISPATCH("roll", 
                 "fixdynamics" "@inconsistent" 1 "@unnecessary" 1 
            )
        );
        BP_PLAY_TOGGLE == 1 && BP_FN_DISPATCH("playtoggle", BP_PLAY_TOGGLE)
    )
);

BP_FN_ON_FAIL = (
    -> (
        BP_VIEWER_DATA = null;
        BP_DATABASE_BROWSER = null;
        BP_PLAY_TOGGLE = 0
    )
);

BP_FN_ERROR = (
    $origin,
    $details,
    $stop = 1 -> (
        if $stop == 1 then (
            BP_FN_ON_FAIL()
        );
        BP_FN_DISPATCH("console",
            [ "code" $stop == 0 ]
            [ "type" 2 - $stop ]
            [ "text" ($origin &&& ($origin "→")) $details ]
        );
        null
    )
);

BP_FN_PRINT = (
    $text -> (
        BP_FN_DISPATCH("console",
            [ "code" 1 ]
            [ "type" 0 ]
            [ "text" $text ]
        )
    )
);

BP_FN_WARNING = (
    $origin,
    $details -> (
        BP_FN_ERROR(@origin $origin @details $details @stop 0)
    )
);

BP_REF_DEPRECATED_WARNING = (
    $name = null, $suggest = null -> (
        BP_FN_WARNING("`" + $name "` will be deprecated." (if is($suggest) == 'symbol' then ("Use instead `" + $suggest + "`.") else ""))
    )
);

BP_FN_CHECK_ARGS = (
    $origin, <...> -> (
        $missing = null;
        for $i in (1...($argcount / 2)) * 2 do (
            if $args($i + 1) == null then ($missing _= $args($i)) 
        );
        if $missing == null then 1 else (
            $details = for $m in $missing collect '@' + $m;
            BP_FN_ERROR($origin, 'unexpected null value:' $details) 
        ) 
    ) 
);

BP_FN_VALIDATE_BUFFER = (
    $origin,
    $buffer -> (
        $source = getkey($buffer, "source");
        $source ||| BP_FN_ERROR($origin, 'invalid buffer:' $buffer)
    )
);

## ------------------------------------------------------------

BP_REF_MULTILINE = (
    <...> -> (
        $break = '
';
        $symbol = '';
        $lines = $args(1...$argcount);
        for $line in $lines do ($symbol = $symbol + $line + $break);
        $symbol
    ) 
);

## ------------------------------------------------------------

BP_REF_CODE_SNIPPET = (
    <...>, $caption = null, $showlines = 1 -> (
        $lines = $args(1...$argcount);
        $code = BP_REF_MULTILINE(
            $caption '', '```bell' + (if $showlines == 1 then ' showLineNumbers' else ''), $lines, '```', '' 
        ) 
    ) 
);

## ------------------------------------------------------------

BP_REF_PROCESS_EXAMPLE = (
    $name, $params = "", $buffer = "importaudio('singing.wav')" -> (
        $open = "(";
        $close = ")";
        $break = "
";
        $tab = "    ";
        $code = BP_REF_CODE_SNIPPET(
            "$buffer = " + $buffer + "; ## input buffer",
            "$op = " + $name + "(" + $params + "); ## processing operation",
            "$buffer = $buffer.process($op); ## apply processing",
            "$buffer.view('after " + $name + " process')"
        );
        $text = $break + $break + "`" + $name + "` is meant to be used with the `process` function:" + $break;
        $text + $code
    ) 
);

BP_REF_GENERATION_EXAMPLE = (
    $name, $params = "" -> (
        $open = "(";
        $close = ")";
        $break = "
";
        $tab = "    ";
        $code = BP_REF_CODE_SNIPPET(
            "$buffer = " + $name + "(" + $params + ");",
            "$buffer.view('" + $name + " buffer')"
        );
        $code
    ) 
);

BP_REF_ANALYZE_EXAMPLE = (
    $name, $params = "", $buffer = "importaudio('singing.wav')" -> (
        $open = "(";
        $close = ")";
        $break = "
";
        $tab = "    ";
        $code = BP_REF_CODE_SNIPPET(
            "$buffer = " + $buffer + "; ## input buffer",
            "$descr = " + $name + "(" + $params + "); ## generate " + $name + " audio descriptor",
            "$buffer.view('before analysis');",
            "$buffer = $buffer.analyze($descr); ## apply analysis",
            "$buffer.view('after analysis')"
        );
        $text = $break + $break + "`" + $name + "` is meant to be used with the `analyze` function:" + $break;
        $text + $code
    ) 
);

BP_REF_DATABASE_SNIPPET = BP_REF_CODE_SNIPPET(
    "## import MIDI events to use as data
$events = importmidi('bach.mid');
## create `notes` table based on MIDI events
createdbtable(@data $events @name 'notes');
## Use SQL query to retrieve all events with pitch class 0
$results = querydb('SELECT * FROM notes WHERE pitch % 1200 == 0');
print($results) ## print results");

BP_REF_DATABASE_IO_SNIPPET = BP_REF_CODE_SNIPPET("$events = importmidi('bach.mid'); ## MIDI as table data
$db1 = 'first'; ## database name 1
$db2 = 'second'; ## database name 2
$path = './mydb.llll'; ## output path
createdbtable(
    @data $events ## table data
    @name 'events' ## table name
    @db $db1 ## database name 1
);
writedb(@path $path @db $db1); ## write database 1
readdb(@path $path @db $db2); ## read and load into database 2
$results = querydb('SELECT * FROM events', $db2); ## query database 2
print($results)");

## ------------------------------------------------------------

BP_REF_NEW = (
    $name, $description, $arguments, $output, $category = BP_REF_LABEL_DATA_UTILS, $anmodes = 0...3, $ankeys = null, $usage = null, $tags = null -> (
        $open = "(";
        $close = ")";
        $tab = "    ";
        ## check if reference belongs to analysis/descriptor function
        if $category == BP_REF_LABEL_BUFFER_GENERATION then (
            $usage = $usage ||| BP_REF_GENERATION_EXAMPLE($name);
            $tags _= 'view'
        ) else if $category == BP_REF_LABEL_BUFFER_ANALYSIS then (
            ## check if descriptor supports multiple modes
            $mode = $arguments."@mode";
            if $mode != null then (
                ## if so, filter out unsupported modes
                $mode.'options' = for $i in $anmodes collect ($mode.'options'):($i + 1)
            );
            if $name != 'buf2ptracks' then (
                $tags _= 'analyze' 'view';
                $ankeys = $ankeys ||| $name;
                $description = BP_REF_MULTILINE($description, "", 'The resulting buffer will be updated with the following keys:', "");
                $description = BP_REF_MULTILINE($description, '', for $ankey in $ankeys collect '- `' + $ankey + '`');
                $description = BP_REF_MULTILINE(
                    $description,
                    "",
                    ":::info",
                    "`" + $name + "` is a mirror implementation of the same algorithm in the [Essentia](https://essentia.upf.edu/) library.",
                    "For more details on the algorithm, please check the [Essentia Algorithms reference](https://essentia.upf.edu/algorithms_reference.html)."
                    ":::"
                );
                $usage = $usage ||| BP_REF_ANALYZE_EXAMPLE($name)
            );
            ## re-assign modified arguments
            $arguments."@mode" = $mode
        ) else if $category == BP_REF_LABEL_BUFFER_OPERATIONS then (
            if $name == 'process' then (
                $code = BP_REF_CODE_SNIPPET(
                    "$buffer = importaudio('drums.wav');",
                    "## generate one or more processing operations",
                    "$operations = " + $open, 
                    $tab +  "reverse()",
                    $tab + "freeverb(@tail 1000)",
                    $tab + "reverse()",
                    $close + ";",
                    "$buffer.view('before process');",
                    "## apply operations to buffer",
                    "$buffer = $buffer.process($operations);",
                    "$buffer.view('after process')"
                );
                $usage = $code
            ) else if $usage == null then (
                $usage = BP_REF_PROCESS_EXAMPLE($name)
            );
            $tags _= 'process' 'view'
        );
        ## if function has arguments, split required from optional ones.
        if $arguments != null then (
            $required = null;
            $optional = null;
            for $arg in $arguments do if ($arg::1)."default" == null then (
                $required _= $arg 
            ) else (
                $optional _= $arg
            );
            $arguments = ($required &&& [ "required" $required ]) ($optional &&& [ "optional" $optional ])
        );

        BP_REF.$category _= [
            $name
            [ "description" $description ] 
            [ "arguments" ($arguments ||| "none") ] 
            (
                ## if function is a descriptor, show name of analysis keys
                if $category == BP_REF_LABEL_BUFFER_ANALYSIS then (
                    $ankeys = $ankeys ||| $name;
                    $ankeys = for $k in $ankeys collect [ "'" + $k + "'" ];
                    [ "resulting buffer keys:" $ankeys ]
                )
            )
            [ "output" ($output ||| "null") ]
            [ "usage" $usage ]
            [ "tags" diff($tags, $name) ]
        ]
    )
);

## ------------------------------------------------------------

BP_REF_ARG = (
    $name, $description, $type = "list", $default = null, $options = null -> (
        [
            "@" + $name
            [ "description" $description ]
            [ 'type' $type ]
            ($default &&& [ 'default' $default ])
            ($options &&& [ 'options' $options ])
        ]
    )
);

BP_REF_OPT = (
    $value, $description -> (
        [ (if $description then (tosymbol($value) + ":") else $value) $description ]
    )
);

BP_REF_OUTPUT = (
    $description, $type -> [ 'description' $description ] [ 'type' $type ]
);

## ------------------------------------------------------------

BP_FN_DISPATCH = (
    $to, $msg -> (
        $do1 = [ $to $msg ];
        null
    )
);

## ------------------------------------------------------------

BP_FN_PATHINFO = (
    $x,
    $locate = 0 -> (
        BP_FN_DISPATCH("pathinfo", $x);
        if BP_PATH_INFO == null then (
            BP_FN_ERROR(@details "invalid path:" $x) 
        ) else if $locate == 1 && BP_PATH_INFO."extension" != null && BP_PATH_INFO."exists" == 0 then (
            BP_FN_ERROR(@details "file not found:" $x)
        );
        BP_PATH_INFO
    )
);

## ------------------------------------------------------------

BP_FN_CLEAN_AUDIO_PARAM = (
    $origin = null, $param = null, $allowbuffer = 0 -> (
        $source = getkey($param, 'source');
        $clean = null;
        if $source == null then (
            $clean = if length($param) > 1 || depth($param) > 1 then [bpf($param)] else $param
        ) else if $allowbuffer == 1 then (
            $clean = getkey(BP_FN_DETACH_BUFFER($param @origin $origin), 'source') 
        ) else (BP_FN_ERROR($origin @details 'Buffer parameter not supported') );
        $clean
    ) 
);

## ------------------------------------------------------------

BP_FN_DETACH_BUFFER = (
    $buffer = null, 
    $keepkeys = null, 
    $strict = 0,
    $origin = null -> (
        BP_FN_VALIDATE_BUFFER($origin, $buffer);
        if $strict == 0 && getkey($buffer, 'offset') == 0 && getkey($buffer, 'source_end') == getkey($buffer, 'duration') then $buffer else (
            process(
                @buffer $buffer
                @operations BP_FN_DUMMY_PROCESS() 
                @keepkeys $keepkeys
            ) 
        ) 
    ) 
);

## ------------------------------------------------------------

detach = (
    $buffer = null, $keepkeys = null -> (
        BP_FN_DETACH_BUFFER(
            @buffer $buffer
            @keepkeys $keepkeys
            @strict 1
            @origin 'detach'
        )
    ) 
);

BP_REF_NEW(
    @name "detach"
    @description "Creates a hard copy of the input buffer, detaching it from its original source. Mostly useful for when non-lazy modifications of buffer keys (i.e., `'offset'`, `'duration'`) are preferred. Use with caution to prevent memory overhead."
    @category BP_REF_LABEL_BUFFER_UTILS
    @arguments (
        BP_REF_ARG(@name "buffer" @type "llll" @description "Buffer to detach copy from.")
        BP_REF_ARG(@name "keepkeys" @type "symbol/list" @default 'null' @description "Optional list of keys, as symbols, to preserve from input buffer.")
    )
    @output BP_REF_OUTPUT(@description "Detached copy of buffer" @type "llll")
    @usage BP_REF_CODE_SNIPPET("$buffer = importaudio('poem.wav');
$buffer = $buffer.setkey('offset', 2500).setkey('duration', 1000);
$buffer.view('before detaching');
$buffercopy = $buffer.detach();
$buffercopy.view('after detaching')"
    )
);

## ------------------------------------------------------------

parsepath = (
    $path -> (
        $info = BP_FN_PATHINFO($path);
        [for $key in "name" "parent" "extension" collect (
                $val = $info.$key;
                $val &&& [ $key $val ]
            )
        ]
    )
);

BP_REF_NEW(
    @name "parsepath"
    @description "Parses a given path into key-value pairs for the following properties: `'name'` (file or folder name), `'parent'` (path of parent directory), and `'extension'` (file extension, if not a folder)."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "path" @type "symbol" @description "File or folder path.")
    )
    @output BP_REF_OUTPUT(@description "Parsed path" @type "llll")
    @tags 'getkey'
);

## ------------------------------------------------------------

thispath = (
    $parse = 0
    -> if $parse then BP_SCRIPT_PATH.parsepath() else BP_SCRIPT_PATH
);

BP_REF_NEW(
    @name "thispath"
    @description "Returns the path of the current script, as either a symbol or a parsed `llll` path. See `parsepath`."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "parse" @default 0 @type "int" @description "Parse path." @options 
            BP_REF_SWITCH_OPTIONS
        )
    )
    @output BP_REF_OUTPUT(@description "Path to current script" @type "llll")
);

## ------------------------------------------------------------

exists = (
    $path -> (
        $info = BP_FN_PATHINFO($path);
        $info."exists"
    )
);

BP_REF_NEW(
    @name "exists"
    @description "Checks if a file or folder exists. Returns `1` if true or `0` if false."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "path" @type "symbol" @description "File or folder path.")
    )
    @output BP_REF_OUTPUT(@description "`1` if true, `0` if false." @type "int")
);

## ------------------------------------------------------------

readfolder = (
    $path,
    $filetype = "audio" -> (
        $self = 'readfolder';
        BP_FN_CHECK_ARGS($self, 'path', $path);
        BP_TMP_FOLDER = null;
        $info = BP_FN_PATHINFO($path @locate 1);
        if $info."extension" != null then BP_FN_ERROR($self, "invalid folder path:" $path);
        $path = $info."path";
        $types = (
            [ "audio" "WAVE" "AIFF" "Mp3" ]
            [ "midi" "Midi" ]
            [ "text" "TEXT" ]
            [ "folder" "fold" ]
            [ "all" ]
        ).$filetype;
        if $filetype != "all" && $types == null then BP_FN_ERROR($self, "invalid file type:" $filetype);
        BP_FN_DISPATCH("folder",
            [ "types" $types ]
            [ $path ]
        );
        BP_TMP_FOLDER
    )
);

BP_REF_NEW(
    @name "readfolder"
    @description "Returns a list of file paths in specified folder directory."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "path" @type "symbol" @description "Folder path.")
        BP_REF_ARG(@name "filetype" @default "'audio'" @type "symbol" @description "File type." @options
            BP_REF_OPT(@value "'audio'" @description "Audio files")
            BP_REF_OPT(@value "'midi'" @description "Midi files")
            BP_REF_OPT(@value "'text'" @description "Text files")
            BP_REF_OPT(@value "'folder'" @description "Folders")
            BP_REF_OPT(@value "'all'" @description "All folder contents")
        )
    )
    @output BP_REF_OUTPUT(@description "List of file paths" @type "list")
    @usage BP_REF_CODE_SNIPPET("$files = readfolder('./') ## path to some folder")
);

## ------------------------------------------------------------

BP_FN_GET_BUFFER_INFO = (
    $buffer -> (
        BP_FN_DISPATCH("bufferinfo", $buffer);
        BP_TMP_BUFFINFO
    )
);

## ------------------------------------------------------------

interrupt = (
    $print = null -> (
        BP_FN_DISPATCH("console",
            [ "code" 0 ]
            [ "type" 2 ]
            ($print &&& [ "text" $print ])
        );
        null
    )
);

BP_REF_NEW(
    @name "interrupt"
    @description "Disables communication between the current script and the **bellplay~** application, interrupting any backend-dependent operations. Useful for [last-failing](https://en.wikipedia.org/wiki/Fail-fast_system)."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "print" @default "null" @type "anything" @description "Something to print.")
    )
    @usage BP_REF_CODE_SNIPPET(
        '$gate = 0; ## set to non-zero to enable',
        'print($gate);',
        'if $gate == 0 then interrupt("interrupting!");',
        'print(cycle()) ## null if communication is interrupted'
    )
);

## ------------------------------------------------------------

BP_MEDIA_FILES = [
    [ "audio"
        "badinerie.wav"
        "drums.wav"
        "poem.wav"
        "singing.wav"
        "trumpet.wav"
        "guitar.wav"
        "flute.wav"
        "viola.wav"
    ]
    [ "midi"
        "bach.mid"
        "satie.mid"
        "joplin.mid"
    ]
];

## ------------------------------------------------------------

view = (
    $llll, 
    $label = null -> (
        $self = 'view';
        BP_FN_CHECK_ARGS($self, 'llll', $llll);
        BP_VIEWER_DATA _= [
            [ "data" $llll ]
            [ "label" $label ]
        ];
        $llll
    )
);

BP_REF_NEW(
    @name "view"
    @description "Displays _llll_ in the **Viewer** window, which automatically opens after script evaluation is complete. Convenient for inspecting _lllls_, especially buffers. Similar to `print`, it returns the input _llll_ without any modifications."
    @category BP_REF_LABEL_DATA_UTILS
    @arguments (
        BP_REF_ARG(@name "llll" @type "llll" @description "_llll_ to view.")
        BP_REF_ARG(@name "label" @default "null" @type "symbol/null" @description "Optional label to use for _llll_ in **Viewer** window.")
    )
    @output BP_REF_OUTPUT(@description "Input _llll_" @type "llll")
    @usage BP_REF_CODE_SNIPPET('for $i in 1...10 do (
    cycle(@frequency $i * 55 @duration 500).view()
)'
    )
);

## ------------------------------------------------------------

inspect = (
    $buffer, 
    $label = null -> (
        $self = 'inspect';
        BP_REF_DEPRECATED_WARNING(@name $self @suggest 'view');
        BP_FN_CHECK_ARGS($self, 'buffer', $buffer);
        $source = BP_FN_VALIDATE_BUFFER($self, $buffer);
        BP_VIEWER_DATA _= [
            [ "label" $label ||| $source ]
            [ "data" left($buffer, 1) ]
        ];
        $buffer
    )
);

