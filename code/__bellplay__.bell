    @name "clip"
    @description "Generates an audio process operation for applying hard-clip distortion to a buffer."
    @category BP_REF_LABEL_BUFFER_OPERATIONS
    @arguments (
        BP_REF_ARG(@name "threshold" @default 1 @type "int/float/llll" @description "Distortion amplitude threshold, either as single number or envelope.")
