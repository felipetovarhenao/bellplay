paulfreeze = (
    $duration = 1000,
    $position = 0,
    $jitter = 0,
    $timeunit = 0,
    $spectral = 0,
    $framesize = 8192 -> (
        [
            [ "fx" "paulfreeze" ]
            [ "params" 
                [ "duration" $duration ||| 1000 ]
                [ "onset" [ $position $jitter ] ]
                [ "timeunit" $timeunit ]
                [ "spectral" $spectral ]
                [ "framesize" $framesize ]
            ]
        ]
    )
);

