waveshape = (
    $phase = -1 1,
    $duration = 1000 -> (
        $self = 'waveshape';
        $phase = BP_FN_CLEAN_AUDIO_PARAM($self, $phase, 1);
        if is($phase) != 'symbol' then (
            $phase = envelope($phase::1, $duration).getkey("source")
        );
        [
            [ "fx" "waveshape" ]
            [ "params"
                [ "phase" $phase ]
            ]
        ]
    )
);

BP_REF_NEW(
    @name "waveshape"
    @description "Generates an audio process operation for waveshaping a buffer."
    @category BP_REF_LABEL_BUFFER_OPERATIONS
    @arguments (
        BP_REF_ARG(@name "phase" @default -1 1 @type "int/float" @description "Buffer phase envelope between -1 and 1, either as a single number, envelope, or buffer.")
        BP_REF_ARG(@name "duration" @default 1000 @type "int" @description "Envelope duration in milliseconds. Ignored if `@phase` is a buffer.")
    )
    @output BP_REF_OUTPUT(@description "Waveshape operation" @type "llll")
    @usage BP_REF_PROCESS_EXAMPLE('waveshape', '@phase for $x in 0...90 collect [$x xrand(-1, 1) xrand(-0.25, 0.25)] @duration 3000')
);

